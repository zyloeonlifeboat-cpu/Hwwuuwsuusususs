end)

local btSec = MiscTab:Section("bullet tracers", 1)
local btEnabled = false
local btColor = DARK_PURPLE
local btTex = "electro"
local btWidth = 1
local btDur = 3
local btActive = {}
local btTextures = {
    electro = "rbxassetid://139193109954329",
    cool = "rbxassetid://116848240236550",
    cum = "rbxassetid://88263664141635",
    none = "",
}
btSec:Toggle({ Text = "enabled", Flag = "bt_enabled", Default = false, Callback = function(v)
    btEnabled = v
end })
btSec:ColorPicker({ Text = "color", Flag = "bt_color", Default = DARK_PURPLE, Callback = function(c) btColor = c end })
btSec:Dropdown({ Text = "texture", Flag = "bt_tex", Options = { "electro","cool","cum","none" }, Default = "electro",
    Callback = function(v) btTex = v end })
btSec:Slider({ Text = "width", Flag = "bt_w", Min = 0.1, Max = 5, Decimals = 1, Default = 1,
    Callback = function(v) btWidth = v end })
btSec:Slider({ Text = "duration", Flag = "bt_d", Min = 0.5, Max = 10, Decimals = 1, Default = 3,
    Callback = function(v) btDur = v end })

Workspace.DescendantAdded:Connect(function(d)
    if not btEnabled then return end
    if not d:IsA("Beam") then return end
    if d.Name ~= "gb" then return end
    task.defer(function()
        local ray = d.Parent
        if not ray then return end
        local a = ray:IsA("BasePart") and ray.Position or (ray.PrimaryPart and ray.PrimaryPart.Position)
        if not a then return end
        local h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not h or (h.Position - a).Magnitude > 15 then return end
        local b = d.Attachment1 and d.Attachment1.WorldCFrame.Position
        if not b then return end

        local p0 = Instance.new("Part"); p0.Anchored = true; p0.CanCollide = false; p0.Transparency = 1; p0.Size = Vector3.zero; p0.CFrame = CFrame.new(a); p0.Parent = Workspace
        local p1 = Instance.new("Part"); p1.Anchored = true; p1.CanCollide = false; p1.Transparency = 1; p1.Size = Vector3.zero; p1.CFrame = CFrame.new(b); p1.Parent = Workspace
        local a0 = Instance.new("Attachment", p0)
        local a1 = Instance.new("Attachment", p1)
        local beam = Instance.new("Beam")
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.Width0 = btWidth
        beam.Width1 = btWidth
        beam.FaceCamera = true
        beam.LightEmission = 10
        beam.Transparency = NumberSequence.new(0)
        beam.Texture = btTextures[btTex] or btTextures.electro
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureLength = 10
        beam.Color = ColorSequence.new(btColor)
        beam.Parent = p0
        btActive[#btActive + 1] = { p0, p1, tick() }
        pcall(function() d:Destroy() end)
    end)
end)

RunService.RenderStepped:Connect(function()
    local now = tick()
    for i = #btActive, 1, -1 do
        local e = btActive[i]
        if now - e[3] > btDur then
            if e[1] then e[1]:Destroy() end
            if e[2] then e[2]:Destroy() end
            table.remove(btActive, i)
        end
    end
end)

local configs = ConfigTab:Section("configs", 1)
local configName = "default"
configs:Search({ Placeholder = "config name", Label = "name", Live = true, Callback = function(t) configName = t end })
local configDropdown = configs:Dropdown({ Text = "saved configs", Flag = "selected_config", Options = { "" }, Default = "",
    Callback = function(v) if v and v ~= "" then configName = v end end })
local function refreshConfigDropdown()
    local list = SaveManager:List(); if #list == 0 then list = { "" } end
    pcall(function() configDropdown:SetOptions(list) end)
end
refreshConfigDropdown()
configs:ButtonRow({
    { Text = "save", Callback = function()
        if configName == "" then notify("config", "name first", "warn"); return end
        if SaveManager:Save(configName) then refreshConfigDropdown(); notify("config", "saved " .. configName, "success")
        else notify("config", "failed", "error") end
    end },
    { Text = "load", Callback = function()
        if configName == "" then notify("config", "name first", "warn"); return end
        if SaveManager:Load(configName) then notify("config", "loaded " .. configName, "success")
        else notify("config", "failed", "error") end
    end },
})
configs:ButtonRow({
    { Text = "delete", Callback = function()
        if configName == "" then return end
        SaveManager:Delete(configName); refreshConfigDropdown(); notify("config", "deleted", "success")
    end },
    { Text = "set autoload", Callback = function()
        if configName == "" then return end
        SaveManager:SetAutoloadConfig(configName); refreshConfigDropdown(); notify("config", "autoload set", "success")
    end },
})

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Aim.lockKey then
        if Aim.enabled then
            Aim.enabled = false
            Aim.target = nil
            Aim.remembered = nil
            notify("aim", "disabled", "warn")
        else
            Aim.enabled = true
            local t = pickClosest()
            if t then Aim.target = t; Aim.remembered = t; notify("aim", "locked " .. t.DisplayName, "success")
            else notify("aim", "enabled, no target", "success") end
        end
    end
end)

SaveManager:SetLibrary(Library)
Library:BuildFolders("tracedbyvanta")
Library:BuildFolders("tracedbyvanta/game")
SaveManager:SetFolder("tracedbyvanta/game")

if InterfaceManager then
    pcall(function() InterfaceManager:SetLibrary(Library) end)
    pcall(function() InterfaceManager:SetWindow(Window) end)
    pcall(function() InterfaceManager:SetFolder("tracedbyvanta") end)
    if InterfaceManager.BuildInterfaceSection then
        pcall(function() InterfaceManager:BuildInterfaceSection(ConfigTab, 1) end)
    end
end
if ThemeManager then
    pcall(function() ThemeManager:SetLibrary(Library) end)
    pcall(function() ThemeManager:SetFolder("tracedbyvanta") end)
    if ThemeManager.BuildThemeSection then
        pcall(function() ThemeManager:BuildThemeSection(ConfigTab, 1) end)
    end
end

notify("tracedbyvanta", "loaded", "success")
SaveManager:LoadAutoloadConfig()
